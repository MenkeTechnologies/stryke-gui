#!/usr/bin/env stryke
# bin/gui.stk — `gui` CLI launcher for the stryke `gui` package.
#
# Pass-through to `stryke-gui-helper`. Plus a stryke-side `gui build` that
# runs `cargo build --release`.

my @_p = split "/", __FILE__
pop @_p
pop @_p
require join("/", @_p) . "/lib/GUI.stk"

my @argv = @ARGV
if (@argv == 0) {
    p "usage: gui <subcommand> [args] (try `gui help`)"
    exit 1
}

my $first = $argv[0]
if ($first eq "build") {
    GUI::ensure_built()
    p "stryke-gui: helper at " . GUI::helper_path()
    exit 0
}
if ($first eq "version" && @argv == 1) {
    p GUI::version()
    exit 0
}
if ($first eq "help" || $first eq "-h" || $first eq "--help") {
    my $bin = GUI::helper_path()
    my $rc = system "$bin --help"
    exit $rc == 0 ? 0 : 1
}

my $bin = GUI::helper_path()
my @quoted = map { GUI::_shq($_) } @argv
my $cmd = "$bin " . join(" ", @quoted)
my $rc = system $cmd
exit ($rc == 0 ? 0 : ($rc >> 8))
