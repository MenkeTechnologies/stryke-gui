## t/test_main.stk — assertion tests for stryke-gui-sample.
##
## Uses stryke's native test framework (`assert_*` + `test_run`).
## Exercises lib/Sample.stk helpers and the FFI roundtrip into the
## `gui` cdylib via its permission-free `GUI::keyboard_keys()` query.
## Mouse/keyboard/pixel/screenshot ops can't run unattended (need OS
## permissions) so they aren't asserted here.

use GUI
use Sample

# ── Sample::format_screen ──────────────────────────────────────────
val $line = Sample::format_screen(1920, 1080)
assert_contains $line, "1920x1080",      "format_screen embeds dims"
assert_contains $line, "2073600 pixels", "format_screen computes pixel count"

# ── Sample::center ─────────────────────────────────────────────────
val ($cx, $cy) = Sample::center(1920, 1080)
assert_eq $cx, 960, "center x for 1920"
assert_eq $cy, 540, "center y for 1080"

val ($cx2, $cy2) = Sample::center(3, 5)
assert_eq $cx2, 1, "center x truncates toward 0"
assert_eq $cy2, 2, "center y truncates toward 0"

# ── Sample::count_matching ─────────────────────────────────────────
val @sample = ("a", "ab", "ba", "z")
assert_eq Sample::count_matching(\@sample, qr/a/), 3, "count_matching: 3 of 4 match /a/"
assert_eq Sample::count_matching(\@sample, qr/z/), 1, "count_matching: 1 of 4 match /z/"
assert_eq Sample::count_matching(\@sample, qr/x/), 0, "count_matching: 0 of 4 match /x/"

# ── GUI::keyboard_keys FFI roundtrip (permission-free) ─────────────
val @keys = GUI::keyboard_keys()
assert_gt scalar(@keys), 100, "GUI::keyboard_keys returns >100 names"

val %seen = map { $_ => 1 } @keys
assert_ok $seen{enter}, "keys contain 'enter'"
assert_ok $seen{shift}, "keys contain 'shift'"
assert_ok $seen{f1},    "keys contain 'f1'"

# ── Sample::format_keys_summary against the real key list ──────────
val $fcount = Sample::count_matching(\@keys, qr/^f\d+$/)
assert_ge $fcount, 24, "f1..f24 all present"

val $summary = Sample::format_keys_summary(\@keys)
assert_match qr/\d+ total/,    $summary, "summary contains total"
assert_match qr/\d+ function/, $summary, "summary contains function count"
assert_match qr/\d+ media/,    $summary, "summary contains media count"

test_run
