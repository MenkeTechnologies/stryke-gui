## lib/GUI.stk — GUI automation for stryke (`use GUI`).
##
## Thin wrapper around the `stryke-gui` cdylib's `gui__*` exports. The cdylib
## is dlopened in-process on first `use GUI` (see stryke's
## `pkg/commands.rs::try_load_ffi_for`) and registers each export as a
## stryke-callable function via `rust_ffi::load_cdylib`. Every wrapper here
## builds a JSON args dict, calls the FFI symbol, and parses the JSON return.
##
## Replaces the v1 helper-binary model (fork(2) + exec(2) + JSON-over-pipe
## per call) with a single dlopen + direct function call per op. The
## `Enigo` input handle persists in `OnceCell` inside the cdylib for the
## life of the stryke process — no per-call init.
##
## Permissions are unchanged: macOS prompts once for Accessibility on the
## first input event (mouse/keyboard) and once for Screen Recording on the
## first pixel/screenshot call. Wayland needs the virtual-pointer +
## screenshot portal. X11 / Windows are unconditioned.

package GUI

# ── error dispatch ────────────────────────────────────────────────────

## Decode the JSON returned by a `gui__*` FFI call and die with a
## descriptive message when the cdylib reported an error.
fn GUI::_decode ($name, $json) {
    val $o = from_json $json
    if (ref $o eq "HASH" && exists $o->{error}) {
        die "GUI::$name: $o->{error}"
    }
    $o
}

# ── mouse: position / size ────────────────────────────────────────────

## Current cursor position → ($x, $y).
fn GUI::mouse_pos {
    val $o = GUI::_decode("mouse_pos", gui__mouse_pos("{}"))
    ($o->{x}, $o->{y})
}

## Primary display dimensions → ($w, $h).
fn GUI::screen_size {
    val $o = GUI::_decode("screen_size", gui__screen_size("{}"))
    ($o->{width}, $o->{height})
}

## Alias for screen_size (pyautogui's `size()` spelling).
fn GUI::mouse_size {
    GUI::screen_size()
}

## 1 if ($x, $y) is on the primary display, else 0.
fn GUI::on_screen ($x, $y) {
    val $o = GUI::_decode("on_screen", gui__screen_on_screen(to_json({ x => $x, y => $y })))
    $o->{on_screen} ? 1 : 0
}

# ── mouse: motion ─────────────────────────────────────────────────────

## Absolute move to ($x, $y). Optional $duration seconds animates the path.
fn GUI::mouse_move ($x, $y, $duration = 0) {
    GUI::_decode("mouse_move",
        gui__mouse_move(to_json({ x => $x, y => $y, duration => $duration })))
    1
}

## Relative move by ($dx, $dy). Optional $duration seconds animates.
fn GUI::mouse_move_rel ($dx, $dy, $duration = 0) {
    GUI::_decode("mouse_move_rel",
        gui__mouse_move_rel(to_json({ dx => $dx, dy => $dy, duration => $duration })))
    1
}

## Press-drag to ($x, $y). Optional $duration + $button.
fn GUI::mouse_drag ($x, $y, $duration = 0, $button = "left") {
    GUI::_decode("mouse_drag",
        gui__mouse_drag(to_json({
            x        => $x,
            y        => $y,
            duration => $duration,
            button   => $button,
            relative => \0,
        })))
    1
}

## Press-drag by ($dx, $dy).
fn GUI::mouse_drag_rel ($dx, $dy, $duration = 0, $button = "left") {
    GUI::_decode("mouse_drag",
        gui__mouse_drag(to_json({
            x        => $dx,
            y        => $dy,
            duration => $duration,
            button   => $button,
            relative => \1,
        })))
    1
}

# ── mouse: buttons ────────────────────────────────────────────────────

## Click at the current position, or at ($x, $y) if both are defined.
## %opts: x, y, clicks (default 1), interval (default 0), button (default left).
fn GUI::mouse_click (%opts) {
    var %args = (
        clicks   => exists $opts{clicks}   ? $opts{clicks}   : 1,
        interval => exists $opts{interval} ? $opts{interval} : 0,
        button   => exists $opts{button}   ? $opts{button}   : "left",
    )
    $args{x} = $opts{x} if defined $opts{x}
    $args{y} = $opts{y} if defined $opts{y}
    GUI::_decode("mouse_click", gui__mouse_click(to_json(\%args)))
    1
}

## Single right / middle click; optional ($x, $y) to move there first.
fn GUI::mouse_right_click ($x = undef, $y = undef) {
    GUI::mouse_click(x => $x, y => $y, button => "right")
}

## Single middle-button click; optional ($x, $y) to move there first.
fn GUI::mouse_middle_click ($x = undef, $y = undef) {
    GUI::mouse_click(x => $x, y => $y, button => "middle")
}

## Double / triple click; optional ($x, $y) and $button.
fn GUI::mouse_double_click ($x = undef, $y = undef, $button = "left") {
    GUI::mouse_click(x => $x, y => $y, clicks => 2, button => $button)
}

## Triple click; optional ($x, $y) and $button.
fn GUI::mouse_triple_click ($x = undef, $y = undef, $button = "left") {
    GUI::mouse_click(x => $x, y => $y, clicks => 3, button => $button)
}

## Press / release a mouse button without the opposite action.
fn GUI::mouse_down ($button = "left") {
    GUI::_decode("mouse_down",
        gui__mouse_button_hold(to_json({ button => $button, press => \1 })))
    1
}

## Wraps the `gui__mouse_button_hold` cdylib export.
fn GUI::mouse_up ($button = "left") {
    GUI::_decode("mouse_up",
        gui__mouse_button_hold(to_json({ button => $button, press => \0 })))
    1
}

# ── mouse: wheel ──────────────────────────────────────────────────────

## Vertical scroll by $clicks (positive = up). Optional ($x, $y) move first.
fn GUI::mouse_scroll ($clicks, $x = undef, $y = undef) {
    var %args = (clicks => $clicks, horizontal => \0)
    $args{x} = $x if defined $x
    $args{y} = $y if defined $y
    GUI::_decode("mouse_scroll", gui__mouse_scroll(to_json(\%args)))
    1
}

## Horizontal scroll by $clicks.
fn GUI::mouse_hscroll ($clicks, $x = undef, $y = undef) {
    var %args = (clicks => $clicks, horizontal => \1)
    $args{x} = $x if defined $x
    $args{y} = $y if defined $y
    GUI::_decode("mouse_hscroll", gui__mouse_scroll(to_json(\%args)))
    1
}

# ── keyboard ──────────────────────────────────────────────────────────

## Press a named key $presses times with $interval seconds between presses.
fn GUI::key_press ($name, $presses = 1, $interval = 0) {
    GUI::_decode("key_press",
        gui__key_press(to_json({ name => $name, presses => $presses, interval => $interval })))
    1
}

## Hold a key down (no release) / release a held key.
fn GUI::key_down ($name) {
    GUI::_decode("key_down", gui__key_down(to_json({ name => $name })))
    1
}

## Wraps the `gui__key_up` cdylib export.
fn GUI::key_up ($name) {
    GUI::_decode("key_up", gui__key_up(to_json({ name => $name })))
    1
}

## Type a literal UTF-8 string. Optional $interval seconds between chars.
fn GUI::key_type ($text, $interval = 0) {
    GUI::_decode("key_type",
        gui__key_type(to_json({ text => $text, interval => $interval })))
    1
}

## Chord: press keys in order, release in reverse. Accepts a list of names.
fn GUI::key_hotkey (@keys) {
    die "GUI::key_hotkey needs at least one key" if @keys == 0
    GUI::_decode("key_hotkey",
        gui__key_hotkey(to_json({ names => \@keys, interval => 0 })))
    1
}

## Every recognized key name → list of strings.
fn GUI::keyboard_keys {
    val $arr = GUI::_decode("keyboard_keys", gui__key_keys("{}"))
    @$arr
}

# ── pixel + screenshot ────────────────────────────────────────────────

## RGB color at ($x, $y) → ($r, $g, $b).
fn GUI::pixel ($x, $y) {
    val $o = GUI::_decode("pixel", gui__pixel(to_json({ x => $x, y => $y })))
    ($o->{r}, $o->{g}, $o->{b})
}

## 1 if the pixel at ($x, $y) matches $rgb (arrayref [r,g,b]) within
## $tolerance per channel, else 0.
fn GUI::pixel_matches_color ($x, $y, $rgb, $tolerance = 0) {
    val $o = GUI::_decode("pixel_match",
        gui__pixel_match(to_json({
            x         => $x,
            y         => $y,
            r         => $rgb->[0],
            g         => $rgb->[1],
            b         => $rgb->[2],
            tolerance => $tolerance,
        })))
    $o->{match} ? 1 : 0
}

## Capture the primary display.
##   GUI::screenshot()           → ($w, $h, \@rgba_bytes)
##   GUI::screenshot("foo.png")  → writes PNG, returns the path.
fn GUI::screenshot ($path = undef) {
    var %args
    $args{output} = $path if defined $path
    val $o = GUI::_decode("screenshot", gui__screenshot(to_json(\%args)))
    if (defined $path) {
        return $o->{path}
    }
    ($o->{width}, $o->{height}, $o->{rgba})
}

## Capture an ($l, $t, $w, $h) region of the primary display.
##   GUI::screenshot_region(L, T, W, H)         → ($w, $h, \@rgba_bytes)
##   GUI::screenshot_region(L, T, W, H, "p.png") → writes PNG, returns path.
fn GUI::screenshot_region ($l, $t, $w, $h, $path = undef) {
    var %args = (region => [$l, $t, $w, $h])
    $args{output} = $path if defined $path
    val $o = GUI::_decode("screenshot_region", gui__screenshot(to_json(\%args)))
    if (defined $path) {
        return $o->{path}
    }
    ($o->{width}, $o->{height}, $o->{rgba})
}
