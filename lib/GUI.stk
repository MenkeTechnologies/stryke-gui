## lib/GUI.stk — GUI automation for stryke (`use GUI`).
##
## Thin wrapper around the `stryke-gui` cdylib's `gui__*` exports. The cdylib
## is dlopened in-process on first `use GUI` (see stryke's
## `pkg/commands.rs::try_load_ffi_for`) and registers each export as a
## stryke-callable function via `rust_ffi::load_cdylib`. Every wrapper here
## builds a JSON args dict, calls the FFI symbol, and parses the JSON return.
##
## Replaces the v1 helper-binary model (fork(2) + exec(2) + JSON-over-pipe
## per call) with a single dlopen + direct function call per op. The
## `Enigo` input handle persists in `OnceCell` inside the cdylib for the
## life of the stryke process — no per-call init.
##
## Permissions are unchanged: macOS prompts once for Accessibility on the
## first input event (mouse/keyboard) and once for Screen Recording on the
## first pixel/screenshot call. Wayland needs the virtual-pointer +
## screenshot portal. X11 / Windows are unconditioned.

package GUI

# ── error dispatch ────────────────────────────────────────────────────

## Decode the JSON returned by a `gui__*` FFI call and die with a
## descriptive message when the cdylib reported an error.
fn GUI::_decode ($name, $json) {
    val $o = from_json $json
    if (ref $o eq "HASH" && exists $o->{error}) {
        die "GUI::$name: $o->{error}"
    }
    $o
}

# ── mouse: position / size ────────────────────────────────────────────

## Current cursor position → ($x, $y).
fn GUI::mouse_pos {
    val $o = GUI::_decode("mouse_pos", gui__mouse_pos("{}"))
    ($o->{x}, $o->{y})
}

## Primary display dimensions → ($w, $h).
fn GUI::screen_size {
    val $o = GUI::_decode("screen_size", gui__screen_size("{}"))
    ($o->{width}, $o->{height})
}

## Enumerate all monitors. Each: { id, name, x, y, width, height, scale,
## primary }. screen_size only reports the primary display.
fn GUI::displays {
    @{ GUI::_decode("displays", gui__displays("{}"))->{displays} }
}

## Screenshot a specific monitor by $id (from GUI::displays). With $path,
## writes a PNG and returns the path; otherwise returns ($w, $h, \@rgba).
fn GUI::display_screenshot ($id, $path = undef) {
    var %args = (display => $id)
    $args{output} = $path if defined $path
    val $o = GUI::_decode("display_screenshot", gui__display_screenshot(to_json(\%args)))
    defined $path ? $o->{path} : ($o->{width}, $o->{height}, $o->{rgba})
}

## Alias for screen_size (pyautogui's `size()` spelling).
fn GUI::mouse_size {
    GUI::screen_size()
}

## 1 if ($x, $y) is on the primary display, else 0.
fn GUI::on_screen ($x, $y) {
    val $o = GUI::_decode("on_screen", gui__screen_on_screen(to_json({ x => $x, y => $y })))
    $o->{on_screen} ? 1 : 0
}

# ── mouse: motion ─────────────────────────────────────────────────────

## Absolute move to ($x, $y). Optional $duration seconds animates the path.
fn GUI::mouse_move ($x, $y, $duration = 0) {
    GUI::_decode("mouse_move",
        gui__mouse_move(to_json({ x => $x, y => $y, duration => $duration })))
    1
}

## Relative move by ($dx, $dy). Optional $duration seconds animates.
fn GUI::mouse_move_rel ($dx, $dy, $duration = 0) {
    GUI::_decode("mouse_move_rel",
        gui__mouse_move_rel(to_json({ dx => $dx, dy => $dy, duration => $duration })))
    1
}

## Press-drag to ($x, $y). Optional $duration + $button.
fn GUI::mouse_drag ($x, $y, $duration = 0, $button = "left") {
    GUI::_decode("mouse_drag",
        gui__mouse_drag(to_json({
            x        => $x,
            y        => $y,
            duration => $duration,
            button   => $button,
            relative => \0,
        })))
    1
}

## Press-drag by ($dx, $dy).
fn GUI::mouse_drag_rel ($dx, $dy, $duration = 0, $button = "left") {
    GUI::_decode("mouse_drag",
        gui__mouse_drag(to_json({
            x        => $dx,
            y        => $dy,
            duration => $duration,
            button   => $button,
            relative => \1,
        })))
    1
}

# ── mouse: buttons ────────────────────────────────────────────────────

## Click at the current position, or at ($x, $y) if both are defined.
## %opts: x, y, clicks (default 1), interval (default 0), button (default left).
fn GUI::mouse_click (%opts) {
    var %args = (
        clicks   => exists $opts{clicks}   ? $opts{clicks}   : 1,
        interval => exists $opts{interval} ? $opts{interval} : 0,
        button   => exists $opts{button}   ? $opts{button}   : "left",
    )
    $args{x} = $opts{x} if defined $opts{x}
    $args{y} = $opts{y} if defined $opts{y}
    GUI::_decode("mouse_click", gui__mouse_click(to_json(\%args)))
    1
}

## Single right / middle click; optional ($x, $y) to move there first.
fn GUI::mouse_right_click ($x = undef, $y = undef) {
    GUI::mouse_click(x => $x, y => $y, button => "right")
}

## Single middle-button click; optional ($x, $y) to move there first.
fn GUI::mouse_middle_click ($x = undef, $y = undef) {
    GUI::mouse_click(x => $x, y => $y, button => "middle")
}

## Double / triple click; optional ($x, $y) and $button.
fn GUI::mouse_double_click ($x = undef, $y = undef, $button = "left") {
    GUI::mouse_click(x => $x, y => $y, clicks => 2, button => $button)
}

## Triple click; optional ($x, $y) and $button.
fn GUI::mouse_triple_click ($x = undef, $y = undef, $button = "left") {
    GUI::mouse_click(x => $x, y => $y, clicks => 3, button => $button)
}

## Press / release a mouse button without the opposite action.
fn GUI::mouse_down ($button = "left") {
    GUI::_decode("mouse_down",
        gui__mouse_button_hold(to_json({ button => $button, press => \1 })))
    1
}

## Wraps the `gui__mouse_button_hold` cdylib export.
fn GUI::mouse_up ($button = "left") {
    GUI::_decode("mouse_up",
        gui__mouse_button_hold(to_json({ button => $button, press => \0 })))
    1
}

# ── mouse: wheel ──────────────────────────────────────────────────────

## Vertical scroll by $clicks (positive = up). Optional ($x, $y) move first.
fn GUI::mouse_scroll ($clicks, $x = undef, $y = undef) {
    var %args = (clicks => $clicks, horizontal => \0)
    $args{x} = $x if defined $x
    $args{y} = $y if defined $y
    GUI::_decode("mouse_scroll", gui__mouse_scroll(to_json(\%args)))
    1
}

## Horizontal scroll by $clicks.
fn GUI::mouse_hscroll ($clicks, $x = undef, $y = undef) {
    var %args = (clicks => $clicks, horizontal => \1)
    $args{x} = $x if defined $x
    $args{y} = $y if defined $y
    GUI::_decode("mouse_hscroll", gui__mouse_scroll(to_json(\%args)))
    1
}

# ── keyboard ──────────────────────────────────────────────────────────

## Press a named key $presses times with $interval seconds between presses.
fn GUI::key_press ($name, $presses = 1, $interval = 0) {
    GUI::_decode("key_press",
        gui__key_press(to_json({ name => $name, presses => $presses, interval => $interval })))
    1
}

## Hold a key down (no release) / release a held key.
fn GUI::key_down ($name) {
    GUI::_decode("key_down", gui__key_down(to_json({ name => $name })))
    1
}

## Wraps the `gui__key_up` cdylib export.
fn GUI::key_up ($name) {
    GUI::_decode("key_up", gui__key_up(to_json({ name => $name })))
    1
}

## Type a literal UTF-8 string. Optional $interval seconds between chars.
fn GUI::key_type ($text, $interval = 0) {
    GUI::_decode("key_type",
        gui__key_type(to_json({ text => $text, interval => $interval })))
    1
}

## Chord: press keys in order, release in reverse. Accepts a list of names.
fn GUI::key_hotkey (@keys) {
    die "GUI::key_hotkey needs at least one key" if @keys == 0
    GUI::_decode("key_hotkey",
        gui__key_hotkey(to_json({ names => \@keys, interval => 0 })))
    1
}

## Every recognized key name → list of strings.
fn GUI::keyboard_keys {
    val $arr = GUI::_decode("keyboard_keys", gui__key_keys("{}"))
    @$arr
}

# ── pixel + screenshot ────────────────────────────────────────────────

## RGB color at ($x, $y) → ($r, $g, $b).
fn GUI::pixel ($x, $y) {
    val $o = GUI::_decode("pixel", gui__pixel(to_json({ x => $x, y => $y })))
    ($o->{r}, $o->{g}, $o->{b})
}

## 1 if the pixel at ($x, $y) matches $rgb (arrayref [r,g,b]) within
## $tolerance per channel, else 0.
fn GUI::pixel_matches_color ($x, $y, $rgb, $tolerance = 0) {
    val $o = GUI::_decode("pixel_match",
        gui__pixel_match(to_json({
            x         => $x,
            y         => $y,
            r         => $rgb->[0],
            g         => $rgb->[1],
            b         => $rgb->[2],
            tolerance => $tolerance,
        })))
    $o->{match} ? 1 : 0
}

## Capture the primary display.
##   GUI::screenshot()           → ($w, $h, \@rgba_bytes)
##   GUI::screenshot("foo.png")  → writes PNG, returns the path.
fn GUI::screenshot ($path = undef) {
    var %args
    $args{output} = $path if defined $path
    val $o = GUI::_decode("screenshot", gui__screenshot(to_json(\%args)))
    if (defined $path) {
        return $o->{path}
    }
    ($o->{width}, $o->{height}, $o->{rgba})
}

## Capture an ($l, $t, $w, $h) region of the primary display.
##   GUI::screenshot_region(L, T, W, H)         → ($w, $h, \@rgba_bytes)
##   GUI::screenshot_region(L, T, W, H, "p.png") → writes PNG, returns path.
fn GUI::screenshot_region ($l, $t, $w, $h, $path = undef) {
    var %args = (region => [$l, $t, $w, $h])
    $args{output} = $path if defined $path
    val $o = GUI::_decode("screenshot_region", gui__screenshot(to_json(\%args)))
    if (defined $path) {
        return $o->{path}
    }
    ($o->{width}, $o->{height}, $o->{rgba})
}

# ── clipboard ────────────────────────────────────────────────────────

## Current clipboard text ("" when the clipboard holds no text).
fn GUI::clipboard_get {
    GUI::_decode("clipboard_get", gui__clipboard_get("{}"))->{text}
}

## Replace the clipboard text with $text. Returns 1.
fn GUI::clipboard_set ($text) {
    GUI::_decode("clipboard_set", gui__clipboard_set(to_json({ text => $text })))
    1
}

# ── pure helpers (no display / input) ─────────────────────────────────

## Parse a hotkey string "ctrl+shift+a" into a hashref { keys, modifiers, key }
## — the last segment is the main key, the rest are modifiers (lowercased).
fn GUI::parse_hotkey ($hotkey) {
    GUI::_decode("parse_hotkey", gui__parse_hotkey(to_json({ hotkey => $hotkey })))
}

## Canonicalize a hotkey from parts into one accelerator string — the normalizing
## inverse of parse_hotkey. Modifier aliases collapse to the W3C UI Events names
## (ctrl/control→Control, alt/opt/option→Alt, shift→Shift,
## meta/cmd/command/super/win→Meta), duplicates drop, and they emit in the
## canonical order Control, Alt, Shift, Meta before the key (a single letter is
## upper-cased). Accepts the parse_hotkey shape ({ keys }) or explicit
## { modifiers, key }. $opts is a hashref. Returns a hashref { hotkey, modifiers,
## key }.
fn GUI::format_hotkey ($opts) {
    GUI::_decode("format_hotkey", gui__format_hotkey(to_json($opts)))
}

## Parse a color string ("#rgb", "#rrggbb", or "rgb(r,g,b)") into a hashref
## { r, g, b, hex }.
fn GUI::parse_color ($color) {
    GUI::_decode("parse_color", gui__parse_color(to_json({ color => $color })))
}

## Format an RGB $color ([r,g,b] arrayref or { r, g, b } hashref) as a string —
## the inverse of parse_color. opts: format => "hex" (#rrggbb, default) or "rgb"
## (rgb(r, g, b)). Components clamp to 0-255; both notations round-trip through
## parse_color. Returns a hashref { r, g, b, format, formatted }.
fn GUI::format_color ($color, %opts) {
    GUI::_decode("format_color", gui__format_color(to_json({ color => $color, format => $opts{format} })))
}

## Distance between two RGB colors $a and $b (each [r,g,b] arrayref or
## { r, g, b } hashref) → { manhattan, euclidean }. For pixel-match tolerance.
fn GUI::color_distance ($a, $b) {
    GUI::_decode("color_distance", gui__color_distance(to_json({ a => $a, b => $b })))
}

## Perceptual color difference ΔE00 (CIEDE2000) between two RGB colors $a and $b
## (each [r,g,b] or { r, g, b }). Unlike color_distance (RGB-space), this converts
## both to CIELAB (D65) and applies the CIEDE2000 formula, so the number tracks how
## different the colors *look* (ΔE ≈ 1 is just-noticeable, ~100 spans black↔white).
## Returns { delta_e, lab_a:{l,a,b}, lab_b:{l,a,b} }.
fn GUI::delta_e ($a, $b) {
    GUI::_decode("delta_e", gui__delta_e(to_json({ a => $a, b => $b })))
}

## Blend two RGB colors $a and $b (each [r,g,b] or { r, g, b }) by $weight — the
## fraction of $b in the result (default 0.5, clamped 0-1). Linear sRGB
## interpolation (gamma-naive). Returns { r, g, b, hex }. For tints/shades.
fn GUI::mix ($a, $b, $weight = 0.5) {
    GUI::_decode("mix", gui__mix(to_json({ a => $a, b => $b, weight => $weight })))
}

## Rotate a color $color's hue by $degrees in HSL, keeping saturation/lightness —
## the basis of colour schemes (complementary 180, triadic ±120, analogous ±30).
## Wraps mod 360; negative allowed; a grey is unchanged. Returns { r, g, b, hex, h }.
fn GUI::rotate_hue ($color, $degrees) {
    GUI::_decode("rotate_hue", gui__rotate_hue(to_json({ color => $color, degrees => $degrees })))
}

## Nudge a color's HSL lightness by $delta percentage points (keeping hue and
## saturation) — lighten for a positive delta, darken for a negative one. $color
## is [r,g,b] or { r, g, b }; the result l is clamped to [0,100]. Returns
## { r, g, b, hex, l } with the resulting lightness.
fn GUI::adjust_lightness ($color, $delta) {
    GUI::_decode("adjust_lightness", gui__adjust_lightness(to_json({ color => $color, delta => $delta })))
}

## Nudge a color's HSL saturation by $delta percentage points (keeping hue and
## lightness) — saturate for a positive delta, desaturate for a negative one
## (-100 → greyscale). $color is [r,g,b] or { r, g, b }; the result s is clamped
## to [0,100]. Returns { r, g, b, hex, s } with the resulting saturation.
fn GUI::adjust_saturation ($color, $delta) {
    GUI::_decode("adjust_saturation", gui__adjust_saturation(to_json({ color => $color, delta => $delta })))
}

## WCAG 2.1 contrast ratio between two RGB colors $a and $b (each [r,g,b] or
## { r, g, b }) → { ratio, aa_normal, aa_large, aaa_normal, aaa_large }. ratio is
## 1 (identical) to 21 (black vs white); the booleans report whether the pair
## clears each WCAG threshold. Check a foreground/background pair for accessibility.
fn GUI::contrast_ratio ($a, $b) {
    GUI::_decode("contrast_ratio", gui__contrast_ratio(to_json({ a => $a, b => $b })))
}

## WCAG 2.1 relative luminance of a single RGB color (the building block
## contrast_ratio combines), in [0,1]. A common use: luminance > ~0.5 means a
## light color, so pair it with dark text. Returns the luminance number.
fn GUI::relative_luminance ($color) {
    GUI::_decode("relative_luminance", gui__relative_luminance(to_json({ color => $color })))->{luminance}
}

## Convert an RGB color ([r,g,b] arrayref or { r, g, b } hashref, 0-255) to HSL
## per the CSS Color spec → { h, s, l } (h in degrees 0-360, s and l in percent
## 0-100). Useful for deriving hover/active shades by nudging lightness.
fn GUI::to_hsl ($color) {
    GUI::_decode("to_hsl", gui__to_hsl(to_json({ color => $color })))
}

## Convert an RGB color ([r,g,b] or { r, g, b }, 0-255) to HSV/HSB — the model
## colour pickers use → { h, s, v } (h degrees 0-360, s/v percent 0-100). Distinct
## from HSL: v is the brightest channel, l is the midpoint.
fn GUI::to_hsv ($color) {
    GUI::_decode("to_hsv", gui__to_hsv(to_json({ color => $color })))
}

## Convert HSL back to RGB per the CSS Color spec — inverse of to_hsl. $h is in
## degrees (wrapped into 0-360), $s and $l in percent (clamped 0-100). Returns a
## hashref { r, g, b, hex }.
fn GUI::from_hsl ($h, $s, $l) {
    GUI::_decode("from_hsl", gui__from_hsl(to_json({ h => $h, s => $s, l => $l })))
}

## Convert HSV/HSB back to RGB — inverse of to_hsv. $h is in degrees (wrapped
## into 0-360), $s and $v in percent (clamped 0-100). Returns a hashref
## { r, g, b, hex }.
fn GUI::from_hsv ($h, $s, $v) {
    GUI::_decode("from_hsv", gui__from_hsv(to_json({ h => $h, s => $s, v => $v })))
}

## Convert an RGB color ([r,g,b] or { r, g, b }, 0-255) to HWB (Hue-Whiteness-
## Blackness, CSS Color 4) → { h, w, b } (h degrees 0-360, w/b percent 0-100). The
## cylindrical space alongside to_hsl/to_hsv: w = min(r,g,b), b = 1 - max(r,g,b).
fn GUI::to_hwb ($color) {
    GUI::_decode("to_hwb", gui__to_hwb(to_json({ color => $color })))
}

## Convert HWB back to RGB — inverse of to_hwb. $h is in degrees (wrapped into
## 0-360), $w and $b in percent (clamped 0-100). When $w + $b >= 100 the result is
## the gray $w/($w+$b); otherwise the pure hue is scaled by 1-$w-$b and offset by
## $w. Returns a hashref { r, g, b, hex }.
fn GUI::from_hwb ($h, $w, $b) {
    GUI::_decode("from_hwb", gui__from_hwb(to_json({ h => $h, w => $w, b => $b })))
}

## Convert an RGB color ([r,g,b] or { r, g, b }, 0-255) to CMYK (standard
## profile-free formula) → { c, m, y, k } as percentages 0-100. The print-world
## space alongside to_hsl/to_hsv; pure black is k=100, c=m=y=0.
fn GUI::to_cmyk ($color) {
    GUI::_decode("to_cmyk", gui__to_cmyk(to_json({ color => $color })))
}

## Convert CMYK back to RGB — inverse of to_cmyk. $c, $m, $y, $k in percent
## (clamped 0-100). Returns a hashref { r, g, b, hex }.
fn GUI::from_cmyk ($c, $m, $y, $k) {
    GUI::_decode("from_cmyk", gui__from_cmyk(to_json({ c => $c, m => $m, y => $y, k => $k })))
}

## Invert an RGB $color ([r,g,b] or { r, g, b }, 0-255): each channel becomes
## 255 - c (the photographic-negative / RGB complement). Returns
## { r, g, b, hex }.
fn GUI::invert ($color) {
    GUI::_decode("invert", gui__invert(to_json({ color => $color })))
}

## Convert an RGB $color to grayscale using the Rec. 709 luma weights
## (0.2126R + 0.7152G + 0.0722B) — the perceived-brightness gray. Returns
## { r, g, b, hex, gray } where the three channels share the single 0-255 gray.
fn GUI::grayscale ($color) {
    GUI::_decode("grayscale", gui__grayscale(to_json({ color => $color })))
}

## Apply the classic sepia-tone color matrix to an RGB $color (the warm
## brown-tinted aged-photo look); each output channel is a fixed combination of
## the input, clamped 0-255. Returns { r, g, b, hex }.
fn GUI::sepia ($color) {
    GUI::_decode("sepia", gui__sepia(to_json({ color => $color })))
}

## Quantize each channel of an RGB $color to $levels evenly-spaced steps (the
## poster / banding effect); $levels clamps to [2,256] (2 = pure 0/255 two-tone).
## Returns { r, g, b, hex, levels }.
fn GUI::posterize ($color, $levels = 4) {
    GUI::_decode("posterize", gui__posterize(to_json({ color => $color, levels => $levels })))
}

## Shift an RGB $color's warmth by $amount: positive warms (adds to red,
## subtracts from blue), negative cools (the reverse); green is untouched and
## every channel clamps 0-255. A simple additive white-balance nudge. Returns
## { r, g, b, hex }.
fn GUI::temperature ($color, $amount) {
    GUI::_decode("temperature", gui__temperature(to_json({ color => $color, amount => $amount })))
}

## Composite a foreground $fg over a background $bg (source-over): each channel
## is $fg*$alpha + $bg*(1-$alpha). $fg/$bg are [r,g,b] or { r, g, b }; $alpha is
## 0-1 (default 1, clamped). $alpha 1 → $fg, 0 → $bg. Returns { r, g, b, hex }.
fn GUI::alpha_over ($fg, $bg, $alpha = 1) {
    GUI::_decode("alpha_over", gui__alpha_over(to_json({ fg => $fg, bg => $bg, alpha => $alpha })))
}

## Whether an RGB $color is "dark" by WCAG relative luminance (luminance below
## $threshold, default 0.5) — the pick-a-text-color test. $color is [r,g,b] or
## { r, g, b }. Returns { dark, luminance, threshold, text } where text is the
## suggested "white"/"black" foreground.
fn GUI::is_dark ($color, $threshold = 0.5) {
    GUI::_decode("is_dark", gui__is_dark(to_json({ color => $color, threshold => $threshold })))
}

## Convert an RGB $color ([r,g,b] or { r, g, b }, 0-255) to CIELAB (D65) — the
## perceptually-uniform space delta_e works in. Returns { l, a, b } (l in
## [0,100], a/b roughly ±128). Inverse: from_lab.
fn GUI::to_lab ($color) {
    GUI::_decode("to_lab", gui__to_lab(to_json({ color => $color })))
}

## Convert a CIELAB (D65) color back to RGB — inverse of to_lab. $l in [0,100],
## $a and $b roughly ±128; out-of-gamut results clamp per channel. Returns a
## hashref { r, g, b, hex }.
fn GUI::from_lab ($l, $a, $b) {
    GUI::_decode("from_lab", gui__from_lab(to_json({ l => $l, a => $a, b => $b })))
}

## Blend two RGB colors $a and $b (each [r,g,b] or { r, g, b }) in CIELAB space
## by $weight (fraction of $b, default 0.5, clamped 0-1) — the perceptual
## counterpart of mix (which blends in sRGB). $weight 0 → $a, 1 → $b. Returns
## { r, g, b, hex }.
fn GUI::blend_lab ($a, $b, $weight = 0.5) {
    GUI::_decode("blend_lab", gui__blend_lab(to_json({ a => $a, b => $b, weight => $weight })))
}

## Build an evenly-spaced sRGB gradient from $a to $b (each [r,g,b] or
## { r, g, b }) with $steps stops (clamped [2,256], default 5) — endpoints
## inclusive, so a 2-stop gradient is just [$a, $b]. Returns
## { stops => [{ r, g, b, hex }, ...], steps }.
fn GUI::gradient ($a, $b, $steps = 5) {
    GUI::_decode("gradient", gui__gradient(to_json({ a => $a, b => $b, steps => $steps })))
}

## Convert an RGB $color ([r,g,b] or { r, g, b }, 0-255) to CIE XYZ (D65) — the
## linear tristimulus space to_lab/to_oklab bridge through, exposed directly.
## Returns { x, y, z } (nominally [0,1]; white ≈ 0.95047, 1, 1.08883). Inverse:
## from_xyz.
fn GUI::to_xyz ($color) {
    GUI::_decode("to_xyz", gui__to_xyz(to_json({ color => $color })))
}

## Convert a CIE XYZ (D65) color back to RGB — inverse of to_xyz. $x, $y, $z are
## nominally [0,1]; out-of-gamut results clamp per channel. Returns a hashref
## { r, g, b, hex }.
fn GUI::from_xyz ($x, $y, $z) {
    GUI::_decode("from_xyz", gui__from_xyz(to_json({ x => $x, y => $y, z => $z })))
}

## Convert an RGB $color ([r,g,b] or { r, g, b }, 0-255) to Oklab (Ottosson 2020,
## CSS Color 4) — the modern perceptually-uniform space with better hue linearity
## than CIELAB. Returns { l, a, b } (l in [0,1], a/b ≈ ±0.4). Inverse: from_oklab.
fn GUI::to_oklab ($color) {
    GUI::_decode("to_oklab", gui__to_oklab(to_json({ color => $color })))
}

## Convert an Oklab color back to RGB — inverse of to_oklab. $l in [0,1], $a and
## $b ≈ ±0.4; out-of-gamut results clamp per channel. Returns a hashref
## { r, g, b, hex }.
fn GUI::from_oklab ($l, $a, $b) {
    GUI::_decode("from_oklab", gui__from_oklab(to_json({ l => $l, a => $a, b => $b })))
}

## Blend two RGB colors $a and $b (each [r,g,b] or { r, g, b }) in Oklab space by
## $weight (fraction of $b, default 0.5, clamped 0-1) — the most perceptually-even
## blend (mix in sRGB, blend_lab in CIELAB, this in Oklab). $weight 0 → $a, 1 →
## $b. Returns { r, g, b, hex }.
fn GUI::blend_oklab ($a, $b, $weight = 0.5) {
    GUI::_decode("blend_oklab", gui__blend_oklab(to_json({ a => $a, b => $b, weight => $weight })))
}

## Generate a colour scheme from a base $color by rotating its hue in HSL — the
## composite over rotate_hue. $scheme is one of "complementary" (base + 180°),
## "triadic" (±120°), "analogous" (±30°), "split" (split-complementary 150/210°),
## "tetradic" (rectangle +60/180/240°), or "square" (+90/180/270°). The base is
## always first; a grey (saturation 0) yields copies of itself. Returns
## { scheme, colors => [{ r, g, b, hex }, ...] }.
fn GUI::scheme ($color, $scheme = "complementary") {
    GUI::_decode("scheme", gui__scheme(to_json({ color => $color, scheme => $scheme })))
}

## Name the nearest CSS named color to an RGB $color ([r,g,b] or { r, g, b }) by
## perceptual distance (ΔE00) — the human-readable label parse_color can't give
## (it only round-trips hex/rgb()). Returns { name, delta_e, r, g, b, hex } for
## the closest name (delta_e 0 = an exact named color).
fn GUI::name_color ($color) {
    GUI::_decode("name_color", gui__name_color(to_json({ color => $color })))
}
