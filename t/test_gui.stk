## t/test_gui.stk — assertion tests for the stryke `GUI` package.
##
## Uses stryke's native test framework (`assert_*` + `test_run`).
## Exercises the FFI surface without needing input/screen permissions:
## `keyboard_keys` is a pure dispatch into a static key-name table inside
## the cdylib (no enigo init, no platform input handle), so it runs
## unattended in CI.
##
## The mouse/keyboard/pixel/screenshot ops themselves need OS permission
## (macOS Accessibility + Screen Recording, Wayland portals), so they are
## not asserted here — they can't run unattended in CI.

use GUI

# ── GUI::keyboard_keys FFI roundtrip (permission-free) ─────────────
# Proves the FFI call path end-to-end: stryke → gui__key_keys → JSON → stryke.
val @keys = GUI::keyboard_keys()
assert_gt scalar(@keys), 100, "GUI::keyboard_keys returns >100 names"

# ── well-known key names are present ───────────────────────────────
val %seen = map { $_ => 1 } @keys
assert_ok $seen{enter}, "keys contain 'enter'"
assert_ok $seen{shift}, "keys contain 'shift'"
assert_ok $seen{f1},    "keys contain 'f1'"

# ── function keys f1..f24 ──────────────────────────────────────────
val @fkeys = grep { /^f\d+$/ } @keys
assert_ge scalar(@fkeys), 24, "f1..f24 all present"

# ── pure helpers (no display/input — always run) ─────────────────────
val $hk = GUI::parse_hotkey("Ctrl+Shift+A")
assert_eq scalar(@{ $hk->{keys} }),      3,   "parse_hotkey: three keys"
assert_eq $hk->{key},                    "a", "parse_hotkey: main key lowercased"
assert_eq scalar(@{ $hk->{modifiers} }), 2,   "parse_hotkey: two modifiers"
assert_eq $hk->{modifiers}[0],           "ctrl", "parse_hotkey: first modifier"

# format_hotkey: canonicalize parts into one accelerator (inverse of parse_hotkey).
assert_eq GUI::format_hotkey({ modifiers => ["cmd", "shift"], key => "a" })->{hotkey}, "Shift+Meta+A", "format_hotkey: aliases + order + upper-case key"
assert_eq GUI::format_hotkey({ modifiers => ["option", "ctrl", "control"], key => "Tab" })->{hotkey}, "Control+Alt+Tab", "format_hotkey: dedupes and orders modifiers"
assert_eq GUI::format_hotkey(GUI::parse_hotkey("super+alt+k"))->{hotkey}, "Alt+Meta+K", "format_hotkey: consumes the parse_hotkey shape (round-trip normalize)"
assert_eq GUI::format_hotkey({ key => "z" })->{hotkey}, "Z", "format_hotkey: a bare key just upper-cases a single letter"
assert_dies fn { GUI::format_hotkey({ modifiers => ["hyper"], key => "a" }) }, "format_hotkey: rejects an unknown modifier"

val $c = GUI::parse_color("#ff8800")
assert_eq $c->{r},   255,        "parse_color: red"
assert_eq $c->{g},   136,        "parse_color: green"
assert_eq $c->{hex}, "#ff8800",  "parse_color: hex round-trip"
assert_eq GUI::parse_color("#f80")->{hex}, "#ff8800", "parse_color: #rgb expands"
assert_eq GUI::parse_color("rgb(0, 128, 255)")->{b}, 255, "parse_color: rgb() form"

# format_color: inverse of parse_color (rgb → string notation).
assert_eq GUI::format_color([255, 136, 0])->{formatted}, "#ff8800", "format_color: default hex notation"
assert_eq GUI::format_color([0, 128, 255], format => "rgb")->{formatted}, "rgb(0, 128, 255)", "format_color: rgb() notation"
assert_eq GUI::format_color([300, -5, 128])->{formatted}, "#ff0080", "format_color: clamps components to 0-255"
# Round-trips through parse_color.
assert_eq GUI::parse_color(GUI::format_color([12, 200, 90], format => "rgb")->{formatted})->{g}, 200, "format_color: round-trips via parse_color"

val $d = GUI::color_distance([0, 0, 0], [3, 4, 0])
assert_eq $d->{manhattan}, 7,   "color_distance: manhattan"
assert_eq $d->{euclidean}, 5,   "color_distance: euclidean (3-4-5)"

# delta_e: CIEDE2000 perceptual color difference (LAB-space, not RGB).
assert_eq GUI::delta_e([10, 20, 30], [10, 20, 30])->{delta_e}, 0, "delta_e: identical colors → 0"
val $bw = GUI::delta_e([0, 0, 0], [255, 255, 255])
assert_ok $bw->{delta_e} > 99.9 && $bw->{delta_e} < 100.1, "delta_e: black↔white ≈ 100"
val $rb = GUI::delta_e([255, 0, 0], [0, 0, 255])
assert_ok $rb->{delta_e} > 50, "delta_e: red vs blue is a large perceptual difference"
assert_ok $rb->{lab_a}{l} > 53.1 && $rb->{lab_a}{l} < 53.3, "delta_e: surfaces CIELAB L* of red (~53.24)"

# mix: weighted sRGB blend of two colors.
assert_eq GUI::mix([0, 0, 0], [255, 255, 255])->{hex}, "#808080", "mix: even mix of black+white is mid-gray"
assert_eq GUI::mix([0, 0, 0], [255, 255, 255], 0)->{hex}, "#000000", "mix: weight 0 → a"
assert_eq GUI::mix([0, 0, 0], [255, 255, 255], 1)->{hex}, "#ffffff", "mix: weight 1 → b"
assert_eq GUI::mix([255, 0, 0], [0, 0, 255])->{hex}, "#800080", "mix: red+blue → purple"
assert_eq GUI::mix([0, 0, 0], [200, 100, 40], 0.25)->{r}, 50, "mix: fractional weight interpolates"
assert_dies fn { GUI::mix([1, 2], [3, 4, 5]) }, "mix: rejects a malformed color"

# rotate_hue: rotate hue in HSL for colour schemes.
assert_eq GUI::rotate_hue([255, 0, 0], 120)->{hex}, "#00ff00", "rotate_hue: red +120 → green (triad)"
assert_eq GUI::rotate_hue([255, 0, 0], 240)->{hex}, "#0000ff", "rotate_hue: red +240 → blue (triad)"
assert_eq GUI::rotate_hue([255, 0, 0], 180)->{hex}, "#00ffff", "rotate_hue: red +180 → cyan (complement)"
assert_eq GUI::rotate_hue([255, 0, 0], 360)->{hex}, "#ff0000", "rotate_hue: +360 is a no-op"
assert_eq GUI::rotate_hue([255, 0, 0], -30)->{hex}, GUI::rotate_hue([255, 0, 0], 330)->{hex}, "rotate_hue: negative wraps"
assert_eq GUI::rotate_hue([128, 128, 128], 90)->{hex}, "#808080", "rotate_hue: grey is unchanged (no chroma)"
assert_dies fn { GUI::rotate_hue([255, 0, 0]) }, "rotate_hue: requires degrees"

# adjust_lightness: nudge HSL lightness (lighten/darken).
assert_eq GUI::adjust_lightness([255, 0, 0], 25)->{hex}, "#ff8080", "adjust_lightness: red +25 → lighter red"
assert_eq GUI::adjust_lightness([255, 0, 0], 50)->{hex}, "#ffffff", "adjust_lightness: red +50 → white"
assert_eq GUI::adjust_lightness([255, 0, 0], -50)->{hex}, "#000000", "adjust_lightness: red -50 → black"
assert_eq GUI::adjust_lightness([255, 0, 0], 10)->{l}, 60, "adjust_lightness: reports the new lightness"
assert_eq GUI::adjust_lightness([0, 0, 0], 1000)->{hex}, "#ffffff", "adjust_lightness: clamps at 100"
assert_dies fn { GUI::adjust_lightness([255, 0, 0]) }, "adjust_lightness: requires delta"

# adjust_saturation: nudge HSL saturation (saturate/desaturate).
assert_eq GUI::adjust_saturation([255, 0, 0], -100)->{hex}, "#808080", "adjust_saturation: red -100 → mid-grey"
assert_eq GUI::adjust_saturation([255, 0, 0], -100)->{s}, 0, "adjust_saturation: reports the new saturation"
assert_eq GUI::adjust_saturation([255, 0, 0], 50)->{hex}, "#ff0000", "adjust_saturation: already-max saturation clamps unchanged"
assert_eq GUI::adjust_saturation([255, 0, 0], -50)->{s}, 50, "adjust_saturation: halves the saturation"
assert_dies fn { GUI::adjust_saturation([255, 0, 0]) }, "adjust_saturation: requires delta"

# contrast_ratio: WCAG 2.1 ratio + threshold flags.
val $bw = GUI::contrast_ratio([0, 0, 0], [255, 255, 255])
assert_eq $bw->{ratio}, 21,        "contrast_ratio: black/white is 21:1"
assert_ok $bw->{aaa_normal},       "contrast_ratio: 21 clears AAA normal"
val $gray = GUI::contrast_ratio([119, 119, 119], [255, 255, 255])
assert_eq $gray->{ratio}, 4.48,    "contrast_ratio: #777 on white = 4.48"
assert_eq $gray->{aa_normal}, 0,   "contrast_ratio: 4.48 just misses AA normal (4.5)"
assert_ok $gray->{aa_large},       "contrast_ratio: 4.48 clears AA large (3.0)"
assert_eq GUI::contrast_ratio([18, 52, 86], [18, 52, 86])->{ratio}, 1, "contrast_ratio: identical colors are 1:1"

# relative_luminance: WCAG building block (0 black .. 1 white).
assert_eq GUI::relative_luminance([0, 0, 0]),       0, "relative_luminance: black is 0"
assert_eq GUI::relative_luminance([255, 255, 255]), 1, "relative_luminance: white is 1"
assert_gt GUI::relative_luminance([0, 255, 0]), GUI::relative_luminance([255, 0, 0]), "relative_luminance: green outweighs red"
assert_gt GUI::relative_luminance([255, 255, 255]), 0.5, "relative_luminance: white is a light color (use dark text)"

# to_hsl: RGB → HSL (CSS reference colors). Bounds avoid float-repr fragility.
val $red = GUI::to_hsl([255, 0, 0])
assert_eq $red->{h}, 0,   "to_hsl: red hue 0"
assert_gt $red->{s}, 99,  "to_hsl: red fully saturated"
assert_gt $red->{l}, 49,  "to_hsl: red lightness ~50"
assert_lt $red->{l}, 51,  "to_hsl: red lightness ~50"
val $white = GUI::to_hsl({ r => 255, g => 255, b => 255 })
assert_lt $white->{s}, 1,    "to_hsl: white is achromatic"
assert_gt $white->{l}, 99,   "to_hsl: white lightness 100"
assert_gt GUI::to_hsl([0, 0, 255])->{h}, 239, "to_hsl: blue hue ~240"
assert_lt GUI::to_hsl([0, 0, 255])->{h}, 241, "to_hsl: blue hue ~240"

# to_hsv: RGB → HSV/HSB (oracle-verified). V is the brightest channel.
val $hred = GUI::to_hsv([255, 0, 0])
assert_eq $hred->{h}, 0,   "to_hsv: red hue 0"
assert_gt $hred->{s}, 99,  "to_hsv: red fully saturated"
assert_gt $hred->{v}, 99,  "to_hsv: red value 100"
# Green (0,128,0): V~50.2 (brightest channel), not HSL's l~25.1.
val $hgreen = GUI::to_hsv([0, 128, 0])
assert_gt $hgreen->{v}, 50, "to_hsv: green value ~50.2 (brightest channel)"
assert_lt $hgreen->{v}, 51, "to_hsv: green value ~50.2"
assert_gt $hgreen->{h}, 119, "to_hsv: green hue ~120"
assert_lt $hgreen->{h}, 121, "to_hsv: green hue ~120"
assert_lt GUI::to_hsv({ r => 128, g => 128, b => 128 })->{s}, 1, "to_hsv: gray is achromatic"
assert_gt GUI::to_hsv([0, 255, 255])->{h}, 179, "to_hsv: cyan hue ~180"

# from_hsl: HSL → RGB (inverse of to_hsl).
assert_eq GUI::from_hsl(0, 100, 50)->{hex},   "#ff0000", "from_hsl: red"
assert_eq GUI::from_hsl(240, 100, 50)->{hex}, "#0000ff", "from_hsl: blue"
assert_eq GUI::from_hsl(0, 0, 100)->{hex},    "#ffffff", "from_hsl: white (achromatic)"
# round-trip: RGB → HSL → RGB reproduces the original.
val $h = GUI::to_hsl([18, 52, 86])
val $rt = GUI::from_hsl($h->{h}, $h->{s}, $h->{l})
assert_eq $rt->{r}, 18, "from_hsl round-trips r"
assert_eq $rt->{g}, 52, "from_hsl round-trips g"
assert_eq $rt->{b}, 86, "from_hsl round-trips b"

# from_hsv: HSV → RGB (inverse of to_hsv).
assert_eq GUI::from_hsv(0, 100, 100)->{hex},   "#ff0000", "from_hsv: red"
assert_eq GUI::from_hsv(120, 100, 100)->{hex}, "#00ff00", "from_hsv: green"
assert_eq GUI::from_hsv(30, 100, 100)->{hex},  "#ff8000", "from_hsv: orange (v is brightest channel)"
assert_eq GUI::from_hsv(0, 0, 0)->{hex},       "#000000", "from_hsv: black"
# round-trip: RGB → HSV → RGB reproduces the original.
val $v = GUI::to_hsv([255, 128, 0])
val $vrt = GUI::from_hsv($v->{h}, $v->{s}, $v->{v})
assert_eq $vrt->{r}, 255, "from_hsv round-trips r"
assert_eq $vrt->{g}, 128, "from_hsv round-trips g"
assert_eq $vrt->{b}, 0,   "from_hsv round-trips b"

# to_hwb / from_hwb: Hue-Whiteness-Blackness (CSS Color 4).
val $wred = GUI::to_hwb([255, 0, 0])
assert_eq $wred->{w}, 0, "to_hwb: pure hue has no whiteness"
assert_eq $wred->{b}, 0, "to_hwb: pure hue has no blackness"
assert_eq GUI::to_hwb([255, 255, 255])->{w}, 100, "to_hwb: white is all whiteness"
assert_eq GUI::to_hwb([0, 0, 0])->{b},       100, "to_hwb: black is all blackness"
assert_eq GUI::from_hwb(0, 0, 0)->{hex},   "#ff0000", "from_hwb: pure red"
assert_eq GUI::from_hwb(0, 50, 0)->{hex},  "#ff8080", "from_hwb: red + 50% white"
assert_eq GUI::from_hwb(0, 0, 50)->{hex},  "#800000", "from_hwb: red + 50% black"
assert_eq GUI::from_hwb(0, 50, 50)->{hex}, "#808080", "from_hwb: w+b=100 collapses to gray"
val $w = GUI::to_hwb([12, 200, 90])
val $wrt = GUI::from_hwb($w->{h}, $w->{w}, $w->{b})
assert_eq $wrt->{r}, 12,  "from_hwb round-trips r"
assert_eq $wrt->{g}, 200, "from_hwb round-trips g"
assert_eq $wrt->{b}, 90,  "from_hwb round-trips b"

# to_cmyk / from_cmyk: the print-world fourth space (oracle-verified).
val $cred = GUI::to_cmyk([255, 0, 0])
assert_eq $cred->{m}, 100, "to_cmyk: red is full magenta"
assert_eq $cred->{y}, 100, "to_cmyk: red is full yellow"
assert_eq $cred->{k}, 0,   "to_cmyk: red has no black"
val $cblack = GUI::to_cmyk([0, 0, 0])
assert_eq $cblack->{k}, 100, "to_cmyk: black is k=100"
assert_eq $cblack->{c}, 0,   "to_cmyk: black keeps cmy at 0"
assert_eq GUI::from_cmyk(0, 100, 100, 0)->{hex}, "#ff0000", "from_cmyk: rebuilds red"
assert_eq GUI::from_cmyk(0, 0, 0, 100)->{hex},   "#000000", "from_cmyk: k=100 is black"
# round-trip: RGB → CMYK → RGB reproduces the original.
val $cm = GUI::to_cmyk([64, 128, 192])
val $crt = GUI::from_cmyk($cm->{c}, $cm->{m}, $cm->{y}, $cm->{k})
assert_eq $crt->{r}, 64,  "from_cmyk round-trips r"
assert_eq $crt->{g}, 128, "from_cmyk round-trips g"
assert_eq $crt->{b}, 192, "from_cmyk round-trips b"

# to_lab: RGB → CIELAB (D65), the perceptual space delta_e uses.
val $lw = GUI::to_lab([255, 255, 255])
assert_ok $lw->{l} > 99.99 && $lw->{l} < 100.01, "to_lab: white is L*=100"
assert_ok abs($lw->{a}) < 0.02 && abs($lw->{b}) < 0.02, "to_lab: white is neutral (a*,b* ≈ 0)"
val $lr = GUI::to_lab([255, 0, 0])
assert_ok $lr->{l} > 53.1 && $lr->{l} < 53.3, "to_lab: red L* ≈ 53.24 (D65 reference)"
assert_ok $lr->{a} > 80.0 && $lr->{a} < 80.2, "to_lab: red a* ≈ 80.09"
assert_ok GUI::to_lab([0, 0, 0])->{l} < 0.001, "to_lab: black is L*=0"
# agrees with the L* delta_e surfaces for the same color.
assert_ok abs(GUI::to_lab([0, 0, 255])->{l} - GUI::delta_e([0, 0, 255], [0, 0, 0])->{lab_a}{l}) < 0.0001, "to_lab: matches delta_e's CIELAB"

test_run
