## t/test_gui.stk — assertion tests for the stryke `GUI` package.
##
## Uses stryke's native test framework (`assert_*` + `test_run`).
## Exercises the FFI surface without needing input/screen permissions:
## `keyboard_keys` is a pure dispatch into a static key-name table inside
## the cdylib (no enigo init, no platform input handle), so it runs
## unattended in CI.
##
## The mouse/keyboard/pixel/screenshot ops themselves need OS permission
## (macOS Accessibility + Screen Recording, Wayland portals), so they are
## not asserted here — they can't run unattended in CI.

use GUI

# ── GUI::keyboard_keys FFI roundtrip (permission-free) ─────────────
# Proves the FFI call path end-to-end: stryke → gui__key_keys → JSON → stryke.
val @keys = GUI::keyboard_keys()
assert_gt scalar(@keys), 100, "GUI::keyboard_keys returns >100 names"

# ── well-known key names are present ───────────────────────────────
val %seen = map { $_ => 1 } @keys
assert_ok $seen{enter}, "keys contain 'enter'"
assert_ok $seen{shift}, "keys contain 'shift'"
assert_ok $seen{f1},    "keys contain 'f1'"

# ── function keys f1..f24 ──────────────────────────────────────────
val @fkeys = grep { /^f\d+$/ } @keys
assert_ge scalar(@fkeys), 24, "f1..f24 all present"

# ── pure helpers (no display/input — always run) ─────────────────────
val $hk = GUI::parse_hotkey("Ctrl+Shift+A")
assert_eq scalar(@{ $hk->{keys} }),      3,   "parse_hotkey: three keys"
assert_eq $hk->{key},                    "a", "parse_hotkey: main key lowercased"
assert_eq scalar(@{ $hk->{modifiers} }), 2,   "parse_hotkey: two modifiers"
assert_eq $hk->{modifiers}[0],           "ctrl", "parse_hotkey: first modifier"

val $c = GUI::parse_color("#ff8800")
assert_eq $c->{r},   255,        "parse_color: red"
assert_eq $c->{g},   136,        "parse_color: green"
assert_eq $c->{hex}, "#ff8800",  "parse_color: hex round-trip"
assert_eq GUI::parse_color("#f80")->{hex}, "#ff8800", "parse_color: #rgb expands"
assert_eq GUI::parse_color("rgb(0, 128, 255)")->{b}, 255, "parse_color: rgb() form"

val $d = GUI::color_distance([0, 0, 0], [3, 4, 0])
assert_eq $d->{manhattan}, 7,   "color_distance: manhattan"
assert_eq $d->{euclidean}, 5,   "color_distance: euclidean (3-4-5)"

# contrast_ratio: WCAG 2.1 ratio + threshold flags.
val $bw = GUI::contrast_ratio([0, 0, 0], [255, 255, 255])
assert_eq $bw->{ratio}, 21,        "contrast_ratio: black/white is 21:1"
assert_ok $bw->{aaa_normal},       "contrast_ratio: 21 clears AAA normal"
val $gray = GUI::contrast_ratio([119, 119, 119], [255, 255, 255])
assert_eq $gray->{ratio}, 4.48,    "contrast_ratio: #777 on white = 4.48"
assert_eq $gray->{aa_normal}, 0,   "contrast_ratio: 4.48 just misses AA normal (4.5)"
assert_ok $gray->{aa_large},       "contrast_ratio: 4.48 clears AA large (3.0)"
assert_eq GUI::contrast_ratio([18, 52, 86], [18, 52, 86])->{ratio}, 1, "contrast_ratio: identical colors are 1:1"

# to_hsl: RGB → HSL (CSS reference colors). Bounds avoid float-repr fragility.
val $red = GUI::to_hsl([255, 0, 0])
assert_eq $red->{h}, 0,   "to_hsl: red hue 0"
assert_gt $red->{s}, 99,  "to_hsl: red fully saturated"
assert_gt $red->{l}, 49,  "to_hsl: red lightness ~50"
assert_lt $red->{l}, 51,  "to_hsl: red lightness ~50"
val $white = GUI::to_hsl({ r => 255, g => 255, b => 255 })
assert_lt $white->{s}, 1,    "to_hsl: white is achromatic"
assert_gt $white->{l}, 99,   "to_hsl: white lightness 100"
assert_gt GUI::to_hsl([0, 0, 255])->{h}, 239, "to_hsl: blue hue ~240"
assert_lt GUI::to_hsl([0, 0, 255])->{h}, 241, "to_hsl: blue hue ~240"

# to_hsv: RGB → HSV/HSB (oracle-verified). V is the brightest channel.
val $hred = GUI::to_hsv([255, 0, 0])
assert_eq $hred->{h}, 0,   "to_hsv: red hue 0"
assert_gt $hred->{s}, 99,  "to_hsv: red fully saturated"
assert_gt $hred->{v}, 99,  "to_hsv: red value 100"
# Green (0,128,0): V~50.2 (brightest channel), not HSL's l~25.1.
val $hgreen = GUI::to_hsv([0, 128, 0])
assert_gt $hgreen->{v}, 50, "to_hsv: green value ~50.2 (brightest channel)"
assert_lt $hgreen->{v}, 51, "to_hsv: green value ~50.2"
assert_gt $hgreen->{h}, 119, "to_hsv: green hue ~120"
assert_lt $hgreen->{h}, 121, "to_hsv: green hue ~120"
assert_lt GUI::to_hsv({ r => 128, g => 128, b => 128 })->{s}, 1, "to_hsv: gray is achromatic"
assert_gt GUI::to_hsv([0, 255, 255])->{h}, 179, "to_hsv: cyan hue ~180"

# from_hsl: HSL → RGB (inverse of to_hsl).
assert_eq GUI::from_hsl(0, 100, 50)->{hex},   "#ff0000", "from_hsl: red"
assert_eq GUI::from_hsl(240, 100, 50)->{hex}, "#0000ff", "from_hsl: blue"
assert_eq GUI::from_hsl(0, 0, 100)->{hex},    "#ffffff", "from_hsl: white (achromatic)"
# round-trip: RGB → HSL → RGB reproduces the original.
val $h = GUI::to_hsl([18, 52, 86])
val $rt = GUI::from_hsl($h->{h}, $h->{s}, $h->{l})
assert_eq $rt->{r}, 18, "from_hsl round-trips r"
assert_eq $rt->{g}, 52, "from_hsl round-trips g"
assert_eq $rt->{b}, 86, "from_hsl round-trips b"

test_run
